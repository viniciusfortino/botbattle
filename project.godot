; Engine configuration file.
; Editado à mão — abra no editor do Godot 4 para que ele complete os campos gerados.

config_version=5

[application]

config/name="BotBattle"
config/description="Batalha de turnos mobile — visão sobre o ombro."
run/main_scene="res://scenes/hangar/hangar.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Debug="*res://globals/debug.gd"
PlayerLoadout="*res://globals/player_loadout.gd"

[botbattle]

debug/enabled=false

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_2d=1
